node_modules

# The dashboard build output is generated by `make build` (which runs
# the front-end build under the hood) and embedded into the Go binary
# via go:embed. Keep a .gitkeep in dist/ so the embed directive still
# matches something when no build has run — which is also the state
# while the dashboard front-end is being rewritten.
dist/*
!dist/.gitkeep

# Local build caches from the front-end toolchain.
*.tsbuildinfo
